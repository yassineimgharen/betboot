# Provider credentials only. Never enter betting-account credentials.
FOOTBALL_DATA_TOKEN=
ODDS_API_KEY=
# Choose either context provider (existing keys in .env are preserved).
ISPORTS_API_KEY=
API_FOOTBALL_KEY=
DATABASE_URL=sqlite:///betboot.db
RESEARCH_TIMEZONE=America/New_York
HISTORY_SEASONS=2
ODDS_MAX_AGE_SECONDS=600
PROVIDER_REQUEST_INTERVAL=6.1
# Only publisher-permitted official RSS/Atom feeds, if configured.
OFFICIAL_FEED_URLS=[]


# Optional Google AI Studio API access; never use a Google account password.
GEMINI_API_KEY=
# Use an enabled model ID from your Google AI Studio project.
GEMINI_MODEL=

# Maximum new worldwide competition histories per scan (rate-limited).
WORLD_HISTORY_LEAGUES=3

# --- slipbot (python main.py) ---
# Uses FOOTBALL_DATA_TOKEN, ISPORTS_API_KEY and (optional) ODDS_API_KEY above.
SLIP_MIN_ODDS=1.30
SLIP_EXTRA_MARKET_EVENTS=10
SLIP_BOOKMAKER=1xBet
SLIP_TIMEZONE=Africa/Casablanca
SLIP_MAX_DAYS=7
SLIP_TIME_BUDGET=45
SLIP_MAX_ODDS_AGE_HOURS=48
